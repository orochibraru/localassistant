{
	"name": "localassistant",
	"version": "1.0.0",
	"private": true,
	"description": "A small self-hosted home controller: Tuya blinds over the LAN and Mitsubishi heat pumps through MELCloud.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun build src/worker/index.ts --compile --minify --sourcemap --outfile build/worker",
		"start": "./build/server",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && bun check --no-script -p src/service-worker/tsconfig.json && bun check --no-script -p tsconfig.scripts.json",
		"format": "bun fmt",
		"lint": "bun lint",
		"lint:fix": "bun lint --fix",
		"circular": "bun scripts/circular.ts",
		"test": "svelte-kit sync && bun test tests/unit --timeout 120000",
		"test:integration": "bun run build && bun --config=tests/integration/bunfig.toml test tests/integration --timeout 60000",
		"test:e2e": "bun run build && playwright test",
		"db:generate": "drizzle-kit generate",
		"preinstall": "bunx only-allow bun",
		"prepare": "svelte-kit sync || true && prek install --allow-missing-config || true"
	},
	"dependencies": {
		"@better-auth/cimd": "1.7.14",
		"@better-auth/mcp": "1.7.14",
		"@better-auth/oauth-provider": "1.7.14",
		"@better-auth/passkey": "1.7.14",
		"@modelcontextprotocol/server": "2.4.0",
		"better-auth": "1.7.14",
		"drizzle-orm": "0.45.4",
		"hls.js": "1.7.3",
		"mqtt": "5.16.1",
		"nodemailer": "10.2.1",
		"reflect-metadata": "0.2.2",
		"tuyapi": "7.7.1",
		"uqr": "0.1.3",
		"web-push": "3.6.7",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/sora": "5.3.0",
		"@happy-dom/global-registrator": "21.0.4",
		"@internationalized/date": "3.12.4",
		"@j178/prek": "0.5.7",
		"@lucide/svelte": "1.61.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-bun": "1.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/svelte": "5.4.2",
		"@types/bun": "1.4.4",
		"@types/madge": "5.0.3",
		"@types/nodemailer": "8.0.2",
		"@types/web-push": "3.6.4",
		"agnix": "0.59.3",
		"bits-ui": "2.20.2",
		"cn": "0.5.0",
		"drizzle-kit": "0.31.11",
		"madge": "8.0.0",
		"markdownlint-cli2": "0.24.0",
		"mode-watcher": "1.1.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"svelte-sonner": "1.2.1",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tailwint": "1.1.16",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "8.3.5"
	},
	"overrides": {
		"@better-auth/core": "$better-auth",
		"@better-auth/drizzle-adapter": "$better-auth",
		"@better-auth/kysely-adapter": "$better-auth",
		"@better-auth/memory-adapter": "$better-auth",
		"@better-auth/mongo-adapter": "$better-auth",
		"@better-auth/prisma-adapter": "$better-auth",
		"@better-auth/telemetry": "$better-auth"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#plugins/*": "./src/plugins/*"
	},
	"packageManager": "bun@1.4.4",
	"trustedDependencies": [
		"agnix"
	],
	"patchedDependencies": {
		"@sveltejs/adapter-bun@1.0.0": "patches/@sveltejs%2Fadapter-bun@1.0.0.patch"
	}
}
