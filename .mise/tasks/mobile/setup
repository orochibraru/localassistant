#!/usr/bin/env bash
#MISE description="Install the Android SDK packages and the emulator the mobile app builds and runs on"
set -e
case "$(uname -m)" in arm64|aarch64) abi=arm64-v8a ;; *) abi=x86_64 ;; esac
image="system-images;android-36;google_apis_playstore;$abi"
yes | sdkmanager --sdk_root="$ANDROID_HOME" --licenses >/dev/null
sdkmanager --sdk_root="$ANDROID_HOME" "cmdline-tools;23.0" "platform-tools" \
  "platforms;android-37.0" "build-tools;36.0.0" "emulator" "$image"
avd="$ANDROID_HOME/cmdline-tools/23.0/bin/avdmanager"
if ! "$avd" list avd -c | grep -qx localassistant; then
  echo no | "$avd" create avd -n localassistant -k "$image" -d pixel_9
  config="${ANDROID_AVD_HOME:-$HOME/.android/avd}/localassistant.avd/config.ini"
  sed -i.bak 's/^disk.dataPartition.size=.*/disk.dataPartition.size=6G/' "$config" && rm "$config.bak"
fi
