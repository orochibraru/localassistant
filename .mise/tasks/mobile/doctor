#!/usr/bin/env bash
#MISE description="Check what the mobile app needs to build and run: Android SDK and emulator images, iOS simulator runtime"
ok=0
if [ ! -d "$ANDROID_HOME/platform-tools" ]; then
  echo "No Android SDK at $ANDROID_HOME: mise run mobile:setup" >&2; ok=1
else
  for image in "$ANDROID_HOME"/system-images/*/*/*/; do
    [ -d "$image" ] || continue
    [ -f "$image/system.img" ] || { echo "Broken emulator image $image (no system.img): delete it and run mise run mobile:setup" >&2; ok=1; }
  done
fi
if [ "$(uname)" = Darwin ]; then
  xcrun simctl list runtimes 2>/dev/null | grep -q "^iOS" \
    || { echo "No iOS Simulator runtime: xcodebuild -downloadPlatform iOS (about 8 GB)" >&2; ok=1; }
fi
[ "$ok" = 0 ] && echo "Android SDK, emulator images and iOS runtime ok"
exit "$ok"
