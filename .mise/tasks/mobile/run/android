#!/usr/bin/env bash
#MISE description="Build the Android app and run it on the connected phone or emulator, its localhost:5173 reaching mise run dev"
set -e
cd apps/mobile
./gradlew -q :androidApp:assembleDebug
adb wait-for-device
adb reverse tcp:5173 tcp:5173
adb install -r androidApp/build/outputs/apk/debug/androidApp-debug.apk
adb shell am start -n com.orochibraru.localassistant/dev.localassistant.app.MainActivity
